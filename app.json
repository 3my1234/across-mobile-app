{
  "expo": {
    "owner": "atlantic-express",
    "name": "Atl",
    "slug": "across",
    "scheme": "across",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/atlantic-express-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/atlantic-express-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.atlanticexpress.mobile"
    },
    "android": {
      "package": "com.atlanticexpress.mobile",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/atlantic-express-logo.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "orders",
          "color": "#FF4747"
        }
      ],
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": true
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Atlantic Express to access your photos for product reviews."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Atlantic Express to use your location only while you search for nearby verified services."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "99011f08-ee05-4d96-b3fd-0088e26d4f76"
      }
    }
  }
}
