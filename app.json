{
  "expo": {
    "owner": "atlxpres1991",
    "name": "Atl",
    "slug": "across",
    "scheme": "across",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/atlantic-express-logo.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/atlantic-express-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.atlanticexpress.mobile"
    },
    "android": {
      "package": "com.atlanticexpress.mobile",
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/atlantic-express-logo.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "atl-updates-v2",
          "color": "#FF4747"
        }
      ],
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": true
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Atlantic Express to choose photos for messages, reviews, business listings and verification.",
          "cameraPermission": "Allow Atlantic Express to take clear verification and business photos when you choose to use the camera."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Atlantic Express to use your location while you find nearby services, share a location pin, or choose to be available as a driver.",
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-iap"
    ],
    "extra": {
      "eas": {
        "projectId": "c4fe2811-84a1-48bb-9939-3a3e532d1a29"
      }
    }
  }
}
